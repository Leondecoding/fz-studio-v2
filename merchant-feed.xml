---
layout: null
permalink: /merchant-feed.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<rss xmlns:g="http://base.google.com/ns/1.0" version="2.0">
  <channel>
    <title>FZ Studio Products</title>
    <link>{{ site.url }}</link>
    <description>Product data for FZ Studio</description>
    {% assign merchant_products = site.products | sort: "order" %}
    {% for product in merchant_products %}
      {% if product.merchant_enabled != false and product.image and product.image != "" %}
        {% assign feed_availability = product.availability | default: 'in_stock' %}
        {% if product.stock == 0 %}{% assign feed_availability = 'out_of_stock' %}{% endif %}
    <item>
      <g:id>{{ product.product_id | xml_escape }}</g:id>
      <g:title>{{ product.title | xml_escape }}</g:title>
      <g:description>{{ product.description | strip_html | strip_newlines | xml_escape }}</g:description>
      <g:link>{{ product.url | absolute_url | xml_escape }}</g:link>
      <g:image_link>{{ product.image | absolute_url | xml_escape }}</g:image_link>
      <g:condition>{{ product.condition | default: 'new' | xml_escape }}</g:condition>
      <g:availability>{{ feed_availability | xml_escape }}</g:availability>
      <g:price>{{ product.price | xml_escape }} {{ product.currency | default: 'GBP' | xml_escape }}</g:price>
      <g:brand>{{ product.brand | xml_escape }}</g:brand>
      <g:product_type>{{ product.category | xml_escape }} &gt; {{ product.product_type | xml_escape }}</g:product_type>
      {% if product.identifier_exists == false %}<g:identifier_exists>no</g:identifier_exists>{% endif %}
      {% if product.availability_date %}<g:availability_date>{{ product.availability_date | date_to_xmlschema }}</g:availability_date>{% endif %}
    </item>
      {% endif %}
    {% endfor %}
  </channel>
</rss>
